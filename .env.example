# Copy this file to .env and adjust values. .env is git-ignored; never commit it.

# Database connection for the data/charting component (consumed from req_000 v0.02).
DATABASE_URL=postgresql+psycopg://flowguard:changeme@localhost:5432/flowguard_db

# Logging verbosity for flowguard components (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
